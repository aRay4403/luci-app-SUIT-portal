#------------------------------------------------------------------------------
# 深圳信息职业技术大学 校园网 ePortal 自动认证 —— 配置文件
# 位置: /etc/portal-auth.conf
#
# 权限建议: chmod 600 /etc/portal-auth.conf  （含密码）
#------------------------------------------------------------------------------

# 认证服务器地址（勿改）
PORTAL_HOST="10.10.16.56"

# 校园网账号密码
PORTAL_USER="<你的账号>"
PORTAL_PASS="<你的密码>"

# 运营商（可选"电信宽带" / "移动宽带" / "联通宽带"，留空则自动选非 default 的第一项）
PORTAL_SERVICE="电信宽带"

# HTTP 后端：留空自动探测（curl > uclient-fetch > wget）
# 一般不用改，OpenWrt 上会自动用 uclient-fetch
HTTP_BACKEND=""

# 触发网关拦截的探测地址（必须纯 IP —— 本网络 DNS 被封禁）
PROBE_URLS="http://123.123.123.123/ http://114.114.114.114/ http://1.1.1.1/"

# 在线检测地址（必须纯 IP）
ONLINE_CHECK_URL="http://123.123.123.123/"

# ePortal 入口 URL（兜底用，含 & 所以要用单引号）
#
# AC 只在未认证设备首次访问外网时劫持并下发这个入口；之后它若认为本机已认证，
# 就直接 DROP TCP 不再劫持，探测就拿不到入口。入口里的参数对本机是固定值，
# 可以复用（实测复用后仍能换取全新 sessionId）。
# 若为空且 AC 不劫持，认证会失败 —— 建议填好。
PORTAL_ENTRY_URL=''   # 留空 = 每次认证自动探测（不要填占位符，否则会走固定入口分支）

# 日志
LOG_FILE="/var/log/portal-auth.log"

# 检测间隔（秒），由 init 脚本使用
INTERVAL="30"
# 离线/失败时的快速重试间隔（秒）
INTERVAL_OFFLINE="5"
