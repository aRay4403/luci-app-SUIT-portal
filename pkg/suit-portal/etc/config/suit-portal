# 校园网 ePortal 自动认证 —— UCI 配置
#
# 这个文件由 LuCI 页面（服务 -> SUIT 校园网自动认证）读写，也可以手工 uci set。
# 改完记得：uci commit suit-portal && /etc/init.d/suit-portal restart

config service 'main'
	# 是否启用自动认证守护进程
	option enabled '1'

	# 认证服务器（锐捷 ePortal 地址）
	option portal_host '10.10.16.56'

	# 校园网账号 / 密码
	# ⚠️ 默认留空，需要自己填 —— 这是发布用的干净模板，不含任何人的凭据。
	#    填法二选一：
	#      a) 打开 LuCI 页面「服务 -> SUIT 校园网自动认证」填写并保存
	#      b) uci set suit-portal.main.username='你的账号'
	#         uci set suit-portal.main.password='你的密码'
	#         uci commit suit-portal && /etc/init.d/suit-portal restart
	#    账号或密码为空时，守护进程不会发起认证，只会在日志里提示。
	option username ''
	option password ''

	# 运营商：default = 校园网（校内出口）；也可填 电信宽带 / 移动宽带 / 联通宽带
	# serviceSelection 会动态列出可选项，填了服务端没提供的会自动回退（优先 default）
	option service 'default'

	# 在线时的检测间隔（秒）
	option interval '30'

	# 掉线 / 认证失败时的快速重试间隔（秒）
	option interval_offline '5'

	# 连续失败多少次之后开始退避，退避上限（秒）
	# 防止长时间连不上时每 5 秒砸一次认证服务器（会被风控）
	option interval_offline_max '60'

	# 门户入口 URL
	# 留空 = 每次认证都去探测网关劫持拿最新的（推荐，WAN IP 变了也不会失效）
	# 探测不到时才用它兜底；脚本探测到新入口会自动回写到这里
	option entry_url ''

	# 在线探测地址（域名优先 —— 实测纯 IP 探测在本网络会 EPERM）
	option online_check_urls 'http://connect.rom.miui.com/generate_204 http://wifi.vivo.com.cn/generate_204 http://www.baidu.com/'

	# ---- 断网暂停无线 ----
	#
	# 检测到离线（未认证）就关掉无线射频，认证成功后自动恢复。
	# 目的：断网期间不给设备留一个「连得上但没网」的 WiFi。
	#
	# ⚠️ 前提：WAN 必须是有线接入（DHCP / PPPoE）。
	#     如果 WAN 走无线中继（sta 模式），关射频会把 WAN 一起断掉，
	#     认证永远不可能成功 —— 那种拓扑下不要开这个开关。
	# ⚠️ 关闭期间**所有**设备都搜不到这台路由器的 WiFi（一直关到认证成功）。
	#     请确保能用**网线**进 LuCI，否则认证持续失败时会被锁在外面。
	option wifi_pause '0'

	# 断网暂停时具体关哪些频段（仅 wifi_pause=1 时生效）
	# 默认两个都是 1 = 关掉全部无线。想给智能家居留 2.4G 就把 wifi_pause_2g 设成 0。
	option wifi_pause_2g '1'
	option wifi_pause_5g '1'
